<?xml version="1.0"?>
<ruleset name="WP Grid Overlay">
	<description>WordPress Coding Standards for the WP Grid Overlay plugin.</description>

	<file>.</file>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>skills/*</exclude-pattern>
	<exclude-pattern>.codex-plugin/*</exclude-pattern>

	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="wp-grid-overlay"/>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array" value="wpgo,WPGO"/>
		</properties>
	</rule>
</ruleset>
